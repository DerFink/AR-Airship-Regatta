# 2026-11-11 19:20 – Erstversion: Browser-Version richtig ausliefern, Zugangsdaten schützen
# WebAssembly mit dem richtigen Typ ausliefern (sonst lädt der Simulator nicht)
AddType application/wasm .wasm
AddType application/octet-stream .pck
# Zugangsdaten, Hilfsdateien und Testdaten nie ausliefern
<FilesMatch "^(config\.php|config\.sample\.php|lib\.php|models\.json|.*\.sqlite)$">
  Require all denied
</FilesMatch>
# immer die neueste Startseite (index.html leitet auf den aktuellen Build weiter)
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
# komprimiert ausliefern (schnellerer Start)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/wasm application/javascript text/html application/json
</IfModule>
